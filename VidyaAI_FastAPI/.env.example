SECRET_KEY=change-me-to-a-long-random-string
OPENAI_API_KEY=

# Fast chapter detection on upload (TOC only — not full PDF)
CLASSIFICATION_MODEL=gpt-4o-mini

# --- Supabase Postgres (recommended) ---
# Put the plain password in SUPABASE_DB_PASSWORD (even if it contains @ or !).
# Do NOT paste the raw password into DATABASE_URL — @ breaks the URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_DB_PASSWORD=your-database-password
# Required for local dev on Windows — use Session pooler from Supabase Dashboard → Connect
# Direct host db.YOUR_REF.supabase.co often fails DNS ("Name or service not known")
SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432

# Optional: override with a fully URL-encoded DATABASE_URL instead
# DATABASE_URL=postgresql+psycopg2://postgres:Anas%40123Ansari@db.YOUR_REF.supabase.co:5432/postgres?sslmode=require

# Local SQLite fallback (leave DATABASE_URL empty and uncomment below)
# DATABASE_URL=sqlite:///./vidyaai.db

CORS_ORIGINS=https://vidyaai.desaliasolution.com,https://demo.desaliasolution.com,http://localhost:3000

# Max textbook PDF/DOCX upload size (MB)
MAX_UPLOAD_SIZE_MB=500

# Production: do not run ALTER TABLE on every API restart
RUN_STARTUP_DDL=false
RUN_STARTUP_BACKFILL=false
# Set to false in production to hide raw exception text from API clients
EXPOSE_ERROR_DETAILS=true

# WhatsApp (Meta Cloud API) — send practice/mock report cards to parent phones
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=meta
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Razorpay — India individual subscriptions (Standard Web Checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
BILLING_DEV_BYPASS=false

# Hostinger SMTP — student registration OTP (do not use Gmail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=VidyaAI
OTP_TTL_MINUTES=10

# S3 storage
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1

# AWS Polly TTS (Generative = most natural, best for conversational teaching)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
TTS_PROVIDER=polly
POLLY_VOICE_ID=Kajal
POLLY_ENGINE=generative
# Generative is not in ap-south-1 — Singapore supports Kajal generative for India
POLLY_REGION=ap-southeast-1
POLLY_USE_SSML=true

# Gunicorn (production)
GUNICORN_BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=600
